<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.OrderDetailMapper">


    <insert id="insertBatch">
        insert into order_detail values
        <foreach collection="orderDetailList" separator="," item="detail">
            (null, #{detail.name}, #{detail.image}, #{detail.orderId}, #{detail.dishId}, #{detail.setmealId},
            #{detail.dishFlavor}, #{detail.number}, #{detail.amount})
        </foreach>
    </insert>




    <select id="selectByOrderID" resultType="com.sky.entity.OrderDetail">
        SELECT id,
               name,
               order_id,
               dish_id,
               setmeal_id,
               dish_flavor,
               number,
               amount,
               image
        FROM order_detail
        WHERE order_id = #{orderId}
    </select>




</mapper>