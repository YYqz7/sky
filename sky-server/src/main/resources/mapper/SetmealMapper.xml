<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.SetmealMapper">


    <!--添加新套餐_套餐表-->
    <insert id="addNewSetmeal2setmeal" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO setmeal
        <trim prefix="(" suffix=")" suffixOverrides=",">
            category_id,
            name,
            price,
            status,
            <if test="description != null and description != ''">description,</if>
            image,
            create_time,
            update_time,
            create_user,
            update_user
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            #{categoryId},
            #{name},
            #{price},
            #{status},
            <if test="description != null and description != ''">#{description},</if>
            #{image},
            #{createTime},
            #{updateTime},
            #{createUser},
            #{updateUser}
        </trim>
    </insert>

    <!--添加新套餐_套餐细节表-->
    <insert id="addNewSetmeal2setmealDish">
        INSERT INTO setmeal_dish (
        setmeal_id,
        dish_id,
        name,
        price,
        copies
        )
        VALUES
        <foreach collection="list" item="dish" separator=",">
            (
            #{dish.setmealId},
            #{dish.dishId},
            #{dish.name},
            #{dish.price},
            #{dish.copies}
            )
        </foreach>
    </insert>


    <update id="modifySetmealStatus">
        update setmeal
        set status = #{status}
        where id = #{id}
    </update>

    <!--套餐分页查询-->
    <select id="selectPage" resultType="com.sky.vo.SetmealVO">
        select
        s.*,
        c.name as category_name
        from setmeal s
        left join category c on s.category_id = c.id
        <where>
            <if test="name != null and name != ''">
                and s.name like concat('%', #{name}, '%')
            </if>
            <if test="categoryId != null">
                and s.category_id = #{categoryId}
            </if>
            <if test="status != null">
                and s.status = #{status}
            </if>
        </where>
        order by s.create_time desc
    </select>

    <!--    根据id查询套餐-->
    <select id="querySetmealByID" resultType="com.sky.entity.Setmeal">
        select *
        from setmeal
        where id = #{id}
    </select>

    <!--    根据id查询套餐详情-->
    <select id="querySetmealDishByID" resultType="com.sky.entity.SetmealDish">
        select *
        from setmeal_dish
        where setmeal_id = #{id}
    </select>


</mapper>